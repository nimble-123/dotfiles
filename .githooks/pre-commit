#!/usr/bin/env bash
# Blockiert Commits mit Secrets. Aktiv via: git config core.hooksPath .githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks fehlt (brew install gitleaks) – Commit abgebrochen." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
