# Lokale, ungetrackte Hosts (Firma, intern): ~/.ssh/config.d/*
Include ~/.ssh/config.d/*

Host github.com
  HostName github.com
  User git
{{- if not .work }}

# Privat: Keys kommen aus dem 1Password SSH-Agent
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}

# Arbeit: KeePassXC lädt die Keys in den macOS ssh-agent (SSH_AUTH_SOCK)
{{- end }}
